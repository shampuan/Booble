msgid "Tarama Klasörü Seç"
msgstr "Select Scan Folder"

#: booble.py:1215
msgid "Kullanıcı Hariç Tutulan Klasörler"
msgstr "User Excluded Folders"

#: booble.py:1219
msgid "Taramaya dahil edilmeyecek klasörler:"
msgstr "Folders to exclude from scanning:"

#: booble.py:1237
msgid "Hariç Tutulacak Klasörü Seç"
msgstr "Select Folder to Exclude"

#: booble.py:1245
msgid "Uyarı"
msgstr "Warning"

#: booble.py:1245
msgid "Tüm sistem kök dizini (/) hariç tutulamaz."
msgstr "The root directory (/) cannot be excluded."

#: booble.py:1252
msgid "Çakışma Uyarısı"
msgstr "Conflict Warning"

#: booble.py:1252
msgid "Taramak istediğiniz ana klasörün kendisini hariç tutamazsınız."
msgstr "You cannot exclude the main folder you want to scan."

#: booble.py:1272
msgid "Ayarları Kaydet"
msgstr "Save Settings"
